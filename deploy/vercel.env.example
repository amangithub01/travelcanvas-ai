# Reference for two Vercel projects; no deployment is authorized by this file.
# Backend project: repository root, FastAPI framework, Python 3.13.
# Add backend variables only to the backend Vercel project's settings.
RUN_MODE=staging
FRONTEND_ORIGINS=https://amanapp.tech
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Use a private TLS Redis connection, not the Upstash REST URL/token.
REDIS_URL=
REDIS_KEY_PREFIX=travel-public
SERPAPI_API_KEY=
# Public source-backed ordering; no Groq or local Gemma calls.
AI_PROVIDER=none
# Vercel caches are ephemeral; shared request limits stay in Redis.
TRAVEL_CACHE_PATH=/tmp/travel_cache.db
MAX_ACTIVE_PLANS=2
INGRESS_PER_MINUTE=60
USER_PLANS_PER_MINUTE=2
USER_PLANS_PER_DAY=10
GLOBAL_PLANS_PER_DAY=50
SERPAPI_DAILY_REQUEST_LIMIT=2

# Frontend project: travel-frontend root, Next.js framework.
# Add only these public variables to the frontend project's settings.
NEXT_PUBLIC_API_URL=https://api.amanapp.tech
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=https://amanapp.tech
NEXT_PUBLIC_REQUIRE_LOGIN=true
