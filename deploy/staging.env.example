# Copy to deploy/staging.env; it is ignored. Never commit the filled file.
# No values below authorize public deployment.
SITE_ORIGIN=http://127.0.0.1:8080
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SERPAPI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
# Optional local Gemma: AI_PROVIDER=ollama requires a running local Ollama.
AI_PROVIDER=groq
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:1b

# These are staging request allowances, not guaranteed billing limits.
MAX_ACTIVE_PLANS=2
INGRESS_PER_MINUTE=60
USER_PLANS_PER_MINUTE=2
USER_PLANS_PER_DAY=10
GLOBAL_PLANS_PER_DAY=50
SERPAPI_DAILY_REQUEST_LIMIT=200
GROQ_DAILY_REQUEST_LIMIT=50
OLLAMA_DAILY_REQUEST_LIMIT=50
WEATHER_DAILY_REQUEST_LIMIT=200
EXCHANGE_DAILY_REQUEST_LIMIT=100
FOURSQUARE_DAILY_REQUEST_LIMIT=50
