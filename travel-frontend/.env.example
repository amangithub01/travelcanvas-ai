# Public API address only. Provider secrets belong in the backend .env.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Optional cloud accounts. Use ONLY a Supabase publishable key, never a secret/service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set true when the backend runs in staging mode. The API enforces authentication independently.
NEXT_PUBLIC_REQUIRE_LOGIN=false
