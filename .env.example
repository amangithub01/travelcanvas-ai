# Copy to .env only for a new setup. Never overwrite an existing configuration.
SERPAPI_API_KEY=
FOURSQUARE_API_KEY=
GROQ_API_KEY=
# Choose a model available to your Groq account.
GROQ_MODEL=openai/gpt-oss-20b
# Local-only alternative: start Ollama with an already installed Gemma model.
AI_PROVIDER=groq
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma3:1b
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# TRAVEL_CACHE_PATH=travel_cache.db
# Local mode remains open; never expose it publicly.
RUN_MODE=local
# Staging additionally requires REDIS_URL, SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
# and explicit FRONTEND_ORIGINS. See deploy/staging.env.example.
